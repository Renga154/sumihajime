{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Hono on Cloudflare Workers — API + static asset host (single Worker).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:odh": "wrangler deploy --env odh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tmn/domain": "workspace:*",
    "@tmn/drift": "workspace:*",
    "@tmn/rag": "workspace:*",
    "@tmn/rules": "workspace:*",
    "@tmn/schemas": "workspace:*",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@tmn/publish": "workspace:*",
    "@tmn/test-fixtures": "workspace:*",
    "@types/node": "^22.10.5",
    "miniflare": "^4.20250906.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
