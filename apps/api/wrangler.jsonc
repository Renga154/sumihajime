{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 正典Worker。公開URLは独自ドメイン https://sumihajime.com (2026-10-01〜、ADR-017)。
  // workers.dev の https://app.sumihajime.workers.dev も残り、画面はそこから独自ドメインへ 301 で送る
  // (2026-07-26 個人アカウントのサブドメインを旧名から sumihajime に変更・Worker名を app に変更。ADR-008)。
  "name": "app",
  // 個人アカウント(正典)。提供環境(tokyo_odh_145)追加で複数アカウントになったため明示(ADR-008)。
  "account_id": "<ACCOUNT_ID>",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "assets": {
    // The SPA build output from apps/web. Build apps/web before deploying.
    "directory": "../web/dist",
    // なぜ binding が要るのか: 未定義URLへ 404 ステータスを返すため、SPAフォールバック
    // (index.html の配信)を Worker 側で行う。そのために index.html を読み出す口が必要。
    "binding": "ASSETS",
    // なぜ "none" なのか: "single-page-application" だと未定義URLにも Assets が
    // index.html を **200** で返してしまう(=ソフト404。利用者には日本語の404画面が出るのに、
    // クローラと監視には正常ページに見える)。"none" にすると実ファイルの無いパスが Worker へ
    // 落ちてくるので、既知ルート(@tmn/domain の SPA_ROUTES)なら 200、それ以外は 404 で
    // 同じ index.html を返せる。SPAのクライアントルーティングは 404 本文でも通常どおり動く。
    "not_found_handling": "none",
    // Worker を先に通すパス。/api/* に加え、robots.txt / sitemap.xml は Worker が
    // ルート表から生成する(静的ファイルを置かずに済ませ、内容のズレを防ぐ)。
    // security.txt(RFC 9116)も Canonical 行を環境ごとのオリジンから作るため Worker が返す。
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/.well-known/security.txt",
      // 画面(SPA_ROUTES)も Worker が先に受ける。旧URL・www の画面を独自ドメインへ 301 で送るため
      // (canonical-host.ts)。ハッシュ付きの JS/CSS や画像は従来どおり静的配信のまま。
      "/",
      "/wizard",
      "/checklist",
      "/procedures/*",
      "/facilities",
      "/waste",
      "/differences",
      "/about-data",
      "/coverage",
      "/terms",
      "/privacy",
    ],
  },
  // D1: チェックリスト/手続き/施設/ごみ/台帳の読み取り元(T-006)。
  // database_id は 2026-07-22 に `wrangler d1 create tokyo-move-navi` で採番した本番ID(T-011)。
  // ローカル開発は --local で .wrangler 配下のSQLiteが使われ、このIDには接続しない。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tokyo-move-navi",
      "database_id": "b78ed049-7fbb-4ca5-a909-51397a18587c",
      "migrations_dir": "migrations",
    },
  ],
  // Vectorize: 自治体スコープ付きRAGの検索先(T-013)。dims=1536/metric=cosine、
  // metadata index(municipalityCode/category)は投入前に作成済み。
  // remote:true で `wrangler dev` のローカル実行時も本物の索引へ接続する(Vectorizeにローカル模擬なし)。
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "tokyo-move-navi-rag",
      "remote": true,
    },
  ],
  // RAG設定(T-013)。RAG_ENABLED=false の間 /api/chat は 503 を返し、UIはチャットパネルを隠す
  // (既存機能は無傷)。OPENAI_API_KEY は wrangler secret(値はコミット/ログ禁止)。
  // .dev.vars 作成後に RAG_ENABLED=true へ切替え、索引投入してから本番反映する。
  "vars": {
    "RAG_ENABLED": "true",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_CHAT_MODEL": "gpt-4o-mini-2024-07-18",
    "OPENAI_EMBED_MODEL": "text-embedding-3-small",
    "RAG_MIN_SCORE": "0.30",
    // ADR-014: 定期巡回1回あたりに再取得する承認済みソース件数。Workers Free は1回の実行で
    // 外部サブリクエスト50(リダイレクト込み)・CPU 10ms のため、10件を直列に取る
    // (332件は毎時10件で約1.4日で一巡)。
    "DRIFT_BATCH_SIZE": "10",
    // 生成(OpenAI)を伴うチャットの全体1日上限(日本時間の暦日ごと。migrations/0006_chat_usage.sql)。
    // 超えると /api/chat は 429(必要書類の質問・チェックリストは影響なし)。"0" で当日の生成を止められる。
    "CHAT_DAILY_LIMIT": "1500",
    // 独自ドメイン(2026-10-01 取得)。旧URL(app.sumihajime.workers.dev)と www の画面をここへ 301 で送る。
    "CANONICAL_ORIGIN": "https://sumihajime.com",
  },
  // 独自ドメイン。custom_domain は DNS レコードと証明書を Cloudflare が自動で作る(同じアカウントのゾーン)。
  // workers.dev の旧URLも残し、画面だけ転送する(API は移行の間どちらでも応答する)。
  // routes を置くと wrangler は workers.dev を既定で無効にする。旧URLを 301 の転送元として残すため明示する。
  "workers_dev": true,
  "routes": [
    { "pattern": "sumihajime.com", "custom_domain": true },
    { "pattern": "www.sumihajime.com", "custom_domain": true },
  ],
  // 流量制限(Workers Rate Limiting。src/rate-limit.ts)。キーは CF-Connecting-IP(IPv6 は /64)。
  // 数え方は Cloudflare の拠点(colo)単位・期間は 10 か 60 秒のみ。バインディングが無い環境
  // (単体テスト・ローカル)では制限しない。namespace_id はアカウント内で一意な整数文字列。
  //  - API_RATE_LIMITER: /api/* の読み取り等(/api/health を除く)。300回/60秒(当初120。携帯回線の
  //    共有IP・会場の共用Wi-Fiで複数人が同じ鍵になるため、1人の操作の数倍の余裕を持たせる)。画面1枚の読み込みは
  //    数回、ごみ分別の検索は入力停止ごとに1回(300ms のデバウンス)で、人の操作では届かない量。
  //  - CHAT_RATE_LIMITER: POST /api/chat(OpenAI の課金を伴う)。10回/60秒。isolate ごとの
  //    in-memory 制限(10回/分)と同じ値を、拠点単位で確実に効かせる。評価スクリプト(7秒間隔)を
  //    止めない値でもある。総量は別に D1 の1日上限(CHAT_DAILY_LIMIT)が守る。
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "17001",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "17002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // ローカル開発(wrangler dev)で要求URLのホストを localhost にする。既定では routes の先頭
  // (sumihajime.com)になり、POST の送信元検査(src/request-guards.ts)が「画面のオリジン
  // (http://localhost:5173 等)と要求先が違う」と判断して手元のチャット・チェックリストを 403 にする。
  // robots.txt / sitemap.xml がローカルで本番のURLを載せる問題も同時に無くなる。デプロイには影響しない。
  "dev": {
    "host": "localhost",
  },
  // ログ(Workers Logs)。新しい Worker では既定で有効になり、各リクエストのURL・ヘッダ等を自動で
  // 記録する「invocation logs」も付く。プライバシーポリシー(§4・§5)は「許可リストの項目だけを記録し、
  // IPアドレスは記録しない」と約束しているため、自動記録は止め、src/log.ts が出す許可リストの行だけを
  // 残す(保存は最大7日)。設定を省くと既定値に戻るため、明示して固定する。
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false },
  },
  // ADR-014: 公式ソースの定期巡回(src/drift.ts scheduled)。毎時0分。Free の Cron 上限は5本。
  // triggers は env に継承される鍵だが、bindings/vars と同じく env.odh にも明示して読みやすくする。
  "triggers": {
    "crons": ["0 * * * *"],
  },
  // ハッカソン提供環境(tokyo_odh_145)へのミラー(ADR-008)。正典は個人アカウント側
  // (提供環境のPaid権限は2026-09末失効、Final Stageは10/17のため)。bindings/varsは
  // wranglerのenv非継承仕様により全て明示する。デプロイ: wrangler deploy --env odh
  "env": {
    "odh": {
      "name": "sumihajime",
      // ログ設定はトップレベルと同じ(理由は上の observability のコメント)。
      "observability": {
        "enabled": true,
        "logs": { "invocation_logs": false },
        "traces": { "enabled": false },
      },
      "account_id": "<ACCOUNT_ID>",
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "run_worker_first": [
          "/api/*",
          "/robots.txt",
          "/sitemap.xml",
          "/.well-known/security.txt",
          // 画面(SPA_ROUTES)も Worker が先に受ける。旧URL・www の画面を独自ドメインへ 301 で送るため
          // (canonical-host.ts)。ハッシュ付きの JS/CSS や画像は従来どおり静的配信のまま。
          "/",
          "/wizard",
          "/checklist",
          "/procedures/*",
          "/facilities",
          "/waste",
          "/differences",
          "/about-data",
          "/coverage",
          "/terms",
          "/privacy",
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sumihajime",
          "database_id": "7f95495f-a18b-4079-9eb8-287bfe579bfe",
          "migrations_dir": "migrations",
        },
      ],
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "sumihajime-rag",
          "remote": true,
        },
      ],
      "vars": {
        "RAG_ENABLED": "true",
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_CHAT_MODEL": "gpt-4o-mini-2024-07-18",
        "OPENAI_EMBED_MODEL": "text-embedding-3-small",
        "RAG_MIN_SCORE": "0.30",
        // ADR-014: 正典と同じ値(Free の枠: サブリクエスト50・CPU 10ms)。
        "DRIFT_BATCH_SIZE": "10",
        // 正典と同じ1日上限(ミラーの D1 で独立に数える)。
        "CHAT_DAILY_LIMIT": "1500",
        // ミラーは転送しない(ハッカソンの提供環境として、このURLのまま見られるようにする)。
        "CANONICAL_ORIGIN": "",
      },
      // 流量制限は env に継承されないため明示する(値の理由は上の正典側)。namespace_id は
      // アカウントごとに独立なので、正典と同じ番号でも数え方は混ざらない。
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "17001",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "CHAT_RATE_LIMITER",
          "namespace_id": "17002",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      // ミラーは独自ドメインを持たない(ゾーンは正典のアカウントにある)。継承されないよう空にする。
      "routes": [],
      // ADR-014: 正典と同じ毎時巡回(ミラーでも source_drift は環境ごとの D1 に独立して持つ)。
      "triggers": {
        "crons": ["0 * * * *"],
      },
    },
  },
}
