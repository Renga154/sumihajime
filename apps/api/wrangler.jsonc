{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tokyo-move-navi",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "assets": {
    // The SPA build output from apps/web. Non-/api/* requests fall back to
    // index.html (client-side routing). Build apps/web before deploying.
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // API routes hit the Worker first; everything else is served from assets.
    "run_worker_first": ["/api/*"],
  },
  // D1: チェックリスト/手続き/施設/ごみ/台帳の読み取り元(T-006)。
  // database_id は 2026-07-22 に `wrangler d1 create tokyo-move-navi` で採番した本番ID(T-011)。
  // ローカル開発は --local で .wrangler 配下のSQLiteが使われ、このIDには接続しない。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tokyo-move-navi",
      "database_id": "b78ed049-7fbb-4ca5-a909-51397a18587c",
      "migrations_dir": "migrations",
    },
  ],
}
