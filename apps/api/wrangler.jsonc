{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tokyo-move-navi",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "assets": {
    // The SPA build output from apps/web. Non-/api/* requests fall back to
    // index.html (client-side routing). Build apps/web before deploying.
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // API routes hit the Worker first; everything else is served from assets.
    "run_worker_first": ["/api/*"],
  },
  // D1: チェックリスト/手続き/施設/ごみ/台帳の読み取り元(T-006)。
  // database_id はローカル開発用のプレースホルダ。本番は `wrangler d1 create` で採番した
  // 実IDに差し替える(secrets/環境分離はT-011)。ローカルは --local で .wrangler 配下に作成される。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tokyo-move-navi",
      "database_id": "local-placeholder-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
