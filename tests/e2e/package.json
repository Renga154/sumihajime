{
  "name": "@tmn/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "E2E (Playwright) flows, axe-core a11y smoke, and perf checks (T-017). Browser-dependent: run locally/manually, not in CI.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
